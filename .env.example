# ==============================================================================
# JeevanSYNC Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jeevansync?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jeevansync

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & ENCRYPTION SECRETS
# ------------------------------------------------------------------------------
# Generate strong 64+ char random strings for secrets in production
JWT_ACCESS_SECRET=replace_with_a_very_secure_jwt_access_secret_key_32_chars_min
JWT_REFRESH_SECRET=replace_with_a_very_secure_jwt_refresh_secret_key_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# AES-256 Key for field-level encryption of sensitive medical records (exact 32 bytes)
ENCRYPTION_KEY=01234567890123456789012345678901

# ------------------------------------------------------------------------------
# 4. META WHATSAPP CLOUD API INTEGRATION
# ------------------------------------------------------------------------------
# Obtain from https://developers.facebook.com -> WhatsApp Business Platform
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_system_user_access_token_here
WHATSAPP_VERIFY_TOKEN=create_a_custom_random_verification_token_string
WHATSAPP_APP_SECRET=your_meta_app_secret_for_sha256_hmac_verification

# ------------------------------------------------------------------------------
# 5. MONIKACARE AI SERVICE (Google Gemini Free Tier)
# ------------------------------------------------------------------------------
# Provider options: 'gemini' | 'groq' | 'mock'
AI_PROVIDER=gemini
# Get free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_free_tier_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY THRESHOLDS
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
