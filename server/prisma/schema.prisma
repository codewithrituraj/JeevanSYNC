datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  RECEPTION_STAFF
  SUPER_ADMIN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  REFERRED
}

enum AppointmentSource {
  WEB
  WHATSAPP
}

enum WardType {
  GENERAL
  ICU
  HDU
  NICU
  PEDIATRIC
  EMERGENCY
}

enum AmbulanceUrgency {
  HIGH
  CRITICAL
}

enum AmbulanceStatus {
  REQUESTED
  DISPATCHED
  EN_ROUTE
  COMPLETED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
}

enum RecordType {
  CONSULTATION
  LAB_REPORT
  PRESCRIPTION
  DISCHARGE_SUMMARY
  TRIAGE_SUMMARY
}

enum ReminderType {
  APPOINTMENT
  MEDICATION
  LAB_RESULT
  FOLLOW_UP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum ReminderChannel {
  WHATSAPP
  IN_APP
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  phone         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(PATIENT)
  hospitalId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  hospital      Hospital?      @relation("HospitalStaff", fields: [hospitalId], references: [id])
  refreshTokens RefreshToken[]
  doctorProfile Doctor?
  appointments  Appointment[]  @relation("PatientAppointments")
  referrals     Referral[]     @relation("PatientReferrals")
  patientHistory PatientHistory[] @relation("PatientRecords")
  createdRecords PatientHistory[] @relation("CreatedRecords")
  reminders     Reminder[]
  ambulanceRequests AmbulanceRequest[]
  auditLogs     AuditLog[]
  monikaConversations MonikaConversation[]

  @@index([phone])
  @@index([email])
  @@index([role])
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  revoked    Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Hospital {
  id               String            @id @default(uuid())
  name             String
  address          String
  city             String
  state            String?
  pincode          String?
  latitude         Float
  longitude        Float
  contactPhone     String
  emergencyContact String
  isVerified       Boolean           @default(true)
  createdAt        DateTime          @default(now())

  staff            User[]            @relation("HospitalStaff")
  doctors          Doctor[]
  appointments     Appointment[]
  bloodInventory   BloodInventory[]
  diagnosticTests  DiagnosticTest[]
  bedAvailability  BedAvailability[]
  medicineInventory MedicineInventory[]
  sentReferrals    Referral[]        @relation("SentReferrals")
  receivedReferrals Referral[]       @relation("ReceivedReferrals")
  insuranceLinks   HospitalInsurance[]
  patientHistory   PatientHistory[]
  ambulanceRequests AmbulanceRequest[]

  @@index([city])
  @@index([latitude, longitude])
}

model Doctor {
  id               String        @id @default(uuid())
  userId           String        @unique
  hospitalId       String
  specialty        String
  qualification    String
  experienceYears  Int           @default(0)
  consultationFee  Float         @default(0.0)
  scheduleJson     Json?         // weekly schedule: { "monday": ["09:00-13:00", "14:00-17:00"], ... }
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital         Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  patientHistory   PatientHistory[]

  @@index([hospitalId])
  @@index([specialty])
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  doctorId    String
  hospitalId  String
  slotTime    DateTime
  status      AppointmentStatus @default(BOOKED)
  notes       String?
  source      AppointmentSource @default(WEB)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital    Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([slotTime])
}

model BloodInventory {
  id             String     @id @default(uuid())
  hospitalId     String
  bloodGroup     BloodGroup
  unitsAvailable Int        @default(0)
  updatedAt      DateTime   @updatedAt

  hospital       Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, bloodGroup])
  @@index([bloodGroup])
  @@index([hospitalId])
}

model DiagnosticTest {
  id              String   @id @default(uuid())
  hospitalId      String
  testName        String
  category        String   // Pathology, Radiology, Cardiology, etc.
  price           Float
  turnaroundHours Int      @default(24)
  sampleType      String?  // Blood, Urine, Imaging, Swab
  prerequisites   String?  // e.g. 12hr fasting
  available       Boolean  @default(true)
  createdAt       DateTime @default(now())

  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([testName])
  @@index([category])
}

model AmbulanceRequest {
  id              String           @id @default(uuid())
  patientId       String?
  patientName     String
  patientPhone    String
  pickupLatitude  Float
  pickupLongitude Float
  pickupAddress   String
  hospitalId      String?
  urgencyLevel    AmbulanceUrgency @default(CRITICAL)
  status          AmbulanceStatus  @default(REQUESTED)
  notes           String?
  dispatchedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  patient         User?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  hospital        Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([hospitalId])
  @@index([createdAt])
}

model BedAvailability {
  id           String   @id @default(uuid())
  hospitalId   String
  wardType     WardType
  totalBeds    Int      @default(0)
  occupiedBeds Int      @default(0)
  updatedAt    DateTime @updatedAt

  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, wardType])
  @@index([hospitalId])
  @@index([wardType])
}

model MedicineInventory {
  id               String   @id @default(uuid())
  hospitalId       String
  medicineName     String
  genericName      String
  dosageForm       String   // Tablet, Syrup, Injection, Capsule
  strength         String   // e.g. 500mg, 10ml
  stockQty         Int      @default(0)
  price            Float    @default(0.0)
  alternativesJson Json?    // [{ "name": "...", "generic": "...", "manufacturer": "...", "price": ... }]
  updatedAt        DateTime @updatedAt

  hospital         Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([medicineName])
  @@index([genericName])
}

model Referral {
  id                 String         @id @default(uuid())
  patientId          String
  fromHospitalId     String
  toHospitalId       String
  reason             String
  recordSnapshotJson Json?          // encrypted or structured snapshot of medical history at referral time
  status             ReferralStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  patient            User           @relation("PatientReferrals", fields: [patientId], references: [id], onDelete: Cascade)
  fromHospital       Hospital       @relation("SentReferrals", fields: [fromHospitalId], references: [id], onDelete: Cascade)
  toHospital         Hospital       @relation("ReceivedReferrals", fields: [toHospitalId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([fromHospitalId])
  @@index([toHospitalId])
  @@index([status])
}

model InsuranceProvider {
  id             String              @id @default(uuid())
  name           String              @unique
  code           String              @unique
  contactPhone   String?
  claimPortalUrl String?
  createdAt      DateTime            @default(now())

  hospitals      HospitalInsurance[]
}

model HospitalInsurance {
  id                  String            @id @default(uuid())
  hospitalId          String
  insuranceProviderId String
  isCashless          Boolean           @default(true)
  coverageDetails     String?

  hospital            Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  insuranceProvider   InsuranceProvider @relation(fields: [insuranceProviderId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, insuranceProviderId])
  @@index([hospitalId])
  @@index([insuranceProviderId])
}

model PatientHistory {
  id            String     @id @default(uuid())
  patientId     String
  hospitalId    String?
  doctorId      String?
  recordType    RecordType
  encryptedData String     // AES-256 encrypted clinical notes / diagnosis / prescription details
  metadataJson  Json?      // Unencrypted safe search metadata: { "visitDate": "...", "department": "..." }
  createdBy     String
  createdAt     DateTime   @default(now())

  patient       User       @relation("PatientRecords", fields: [patientId], references: [id], onDelete: Cascade)
  creator       User       @relation("CreatedRecords", fields: [createdBy], references: [id], onDelete: Cascade)
  hospital      Hospital?  @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  doctor        Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([recordType])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // VIEW_PATIENT_HISTORY, CREATE_RECORD, EXPORT_DATA, LOGIN, AMBULANCE_DISPATCH
  resource   String   // patient_history, users, ambulance
  resourceId String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource, resourceId])
  @@index([timestamp])
}

model Reminder {
  id          String          @id @default(uuid())
  patientId   String
  type        ReminderType
  title       String
  message     String
  scheduledAt DateTime
  status      ReminderStatus  @default(PENDING)
  channel     ReminderChannel @default(IN_APP)
  createdAt   DateTime        @default(now())

  patient     User            @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([scheduledAt, status])
}

model WhatsAppSession {
  id               String   @id @default(uuid())
  phoneNumber      String   @unique
  currentState     String   @default("IDLE")
  contextDataJson  Json?
  lastActive       DateTime @default(now())

  @@index([phoneNumber])
}

model MonikaConversation {
  id             String    @id @default(uuid())
  userId         String?
  sessionId      String    @unique
  messagesJson   Json      @default("[]")
  lastTriageTier String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
}
